ANTHROPIC_API_KEY=your_api_key_here
# Optionnel : requis seulement si un agent est configure sur un modele OpenAI dans config/models.yaml
OPENAI_API_KEY=
# Optionnel : requis seulement si un agent utilise base_url+api_key_env vers OpenRouter (voir config/models.yaml)
OPENROUTER_API_KEY=

# --- Plateforme web (webapp/) ---
# Genere automatiquement par webapp/set_password.py -- ne pas remplir a la main.
PLATFORM_PASSWORD_HASH=
# Genere automatiquement au premier lancement du serveur -- ne pas remplir a la main.
PLATFORM_SECRET_KEY=
# Genere automatiquement au premier lancement du serveur -- ne pas remplir a la main.
# Chiffre les identifiants clients (Meta, LinkedIn...) au repos dans webapp.sqlite.
PLATFORM_CREDENTIALS_KEY=
# "true" uniquement en production, derriere HTTPS (Cloudflare Tunnel) -- laisser "false" en local.
PLATFORM_HTTPS_ONLY=false
